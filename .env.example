PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Use true apenas para banco hospedado com SSL obrigatório (ex.: Supabase)
DB_SSL=false

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Login administrativo (conta única operacional). Gere o hash com:
# node -e "console.log(require('bcrypt').hashSync('SuaSenhaAdmin', 10))"
ADMIN_EMAIL=
ADMIN_SENHA_HASH=

# Origens do front permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fuso usado para validar "consulta no passado"
TZ_CLINICA=America/Recife

# Tentativas de login/cadastro por IP a cada 15 minutos
AUTH_RATE_LIMIT=50
